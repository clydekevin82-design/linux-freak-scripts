#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bin_dir=${XDG_BIN_HOME:-"$HOME/.local/bin"}
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/linux-freak
shell_name=$(basename "${SHELL:-sh}")

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  c_main=$(printf '\033[38;5;218m')
  c_soft=$(printf '\033[38;5;225m')
  c_reset=$(printf '\033[0m')
else
  c_main=
  c_soft=
  c_reset=
fi

case "$shell_name" in
  zsh) rc_file="$HOME/.zshrc" ;;
  bash) rc_file="$HOME/.bashrc" ;;
  *) rc_file="$HOME/.profile" ;;
esac

mkdir -p "$bin_dir" "$config_dir"

cp "$repo_dir/scripts/freak-sudo" "$bin_dir/freak-sudo"
cp "$repo_dir/scripts/freak-run" "$bin_dir/freak-run"
cp "$repo_dir/scripts/ollama-freak" "$bin_dir/ollama-freak"
cp "$repo_dir/scripts/freak-factor" "$bin_dir/freak-factor"
cp "$repo_dir/scripts/freak-uninstall" "$bin_dir/freak-uninstall"
cp "$repo_dir/scripts/freak-finger" "$bin_dir/freak-finger"
cp "$repo_dir/scripts/freak-shell.sh" "$config_dir/freak-shell.sh"
chmod 755 "$bin_dir/freak-sudo" "$bin_dir/freak-run" "$bin_dir/ollama-freak" "$bin_dir/freak-factor" "$bin_dir/freak-uninstall" "$bin_dir/freak-finger"
chmod 644 "$config_dir/freak-shell.sh"

quote_value() {
  printf '%s' "$1" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/"
}

choose_pairing() {
  default_pairing=${1:-M/M}
  if [ -t 0 ]; then
    printf 'Choose roleplay pairing: 1) M/M  2) F/F  3) M/F  4) F/M [%s] ' "$default_pairing"
    IFS= read -r pairing_choice || pairing_choice=
    case "$pairing_choice" in
      1|M/M|m/m) pairing=M/M ;;
      2|F/F|f/f) pairing=F/F ;;
      3|M/F|m/f) pairing=M/F ;;
      4|F/M|f/m) pairing=F/M ;;
      '') pairing=$default_pairing ;;
      *) pairing=$default_pairing ;;
    esac
  else
    pairing=$default_pairing
  fi
}

if [ ! -r "$config_dir/config" ]; then
  default_pc_name=$(hostname 2>/dev/null || printf 'the machine')
  if [ -t 0 ]; then
    printf '%sWhat should your PC be called when commands beg for it?%s [%s] ' "$c_main" "$c_reset" "$default_pc_name"
    IFS= read -r pc_name || pc_name=
    pc_name=${pc_name:-$default_pc_name}
  else
    pc_name=$default_pc_name
  fi

  choose_pairing M/M

  {
    printf 'FREAK_PC_NAME=%s\n' "$(quote_value "$pc_name")"
    printf 'FREAK_RUN_MODE=quiet\n'
    printf 'FREAK_RUN_STYLE=inline\n'
    printf 'FREAK_ROLEPLAY_PAIRING=%s\n' "$(quote_value "$pairing")"
  } > "$config_dir/config"
  chmod 600 "$config_dir/config"
elif ! grep -Fqs 'FREAK_ROLEPLAY_PAIRING=' "$config_dir/config"; then
  choose_pairing M/M
  printf 'FREAK_ROLEPLAY_PAIRING=%s\n' "$(quote_value "$pairing")" >> "$config_dir/config"
fi

touch "$rc_file"

if ! grep -Fqs '# >>> linux-freak-scripts >>>' "$rc_file"; then
  {
    printf '\n# >>> linux-freak-scripts >>>\n'
    printf '[ -r "$HOME/.config/linux-freak/freak-shell.sh" ] && . "$HOME/.config/linux-freak/freak-shell.sh"\n'
    printf '# <<< linux-freak-scripts <<<\n'
  } >> "$rc_file"
fi

cat <<EOF
${c_main}linux-freak-scripts installed ~♡${c_reset}

${c_soft}Added commands:${c_reset}
  $bin_dir/freak-sudo
  $bin_dir/freak-run
  $bin_dir/ollama-freak
  $bin_dir/freak-factor
  $bin_dir/freak-uninstall
  $bin_dir/freak-finger

${c_soft}Shell integration:${c_reset}
  $rc_file

${c_main}Restart your shell, or run:${c_reset}
  . "$config_dir/freak-shell.sh"
EOF
