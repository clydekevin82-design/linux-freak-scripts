#!/usr/bin/env bash
set -euo pipefail

config_file="${XDG_CONFIG_HOME:-"$HOME/.config"}/linux-freak/config"
env_pc_name=${FREAK_PC_NAME+x}
env_pc_name_value=${FREAK_PC_NAME-}
env_run_mode=${FREAK_RUN_MODE+x}
env_run_mode_value=${FREAK_RUN_MODE-}
env_run_style=${FREAK_RUN_STYLE+x}
env_run_style_value=${FREAK_RUN_STYLE-}
env_pairing=${FREAK_ROLEPLAY_PAIRING+x}
env_pairing_value=${FREAK_ROLEPLAY_PAIRING-}
env_partner_name=${FREAK_PARTNER_NAME+x}
env_partner_name_value=${FREAK_PARTNER_NAME-}

if [ -r "$config_file" ]; then
  # shellcheck disable=SC1090
  . "$config_file"
fi

[ -n "$env_pc_name" ] && FREAK_PC_NAME=$env_pc_name_value
[ -n "$env_run_mode" ] && FREAK_RUN_MODE=$env_run_mode_value
[ -n "$env_run_style" ] && FREAK_RUN_STYLE=$env_run_style_value
[ -n "$env_pairing" ] && FREAK_ROLEPLAY_PAIRING=$env_pairing_value
[ -n "$env_partner_name" ] && FREAK_PARTNER_NAME=$env_partner_name_value

pc_name=${FREAK_PC_NAME:-${HOSTNAME:-$(hostname 2>/dev/null || printf 'the machine')}}
sudo_prompt=${FREAK_SUDO_PROMPT:-"password? be a good boy~ "}
run_mode=${FREAK_RUN_MODE:-quiet}
run_style=${FREAK_RUN_STYLE:-inline}
pairing=${FREAK_ROLEPLAY_PAIRING:-M/M}
default_partner_name=${FREAK_PARTNER_NAME:-Daddy}
session_model=${OLLAMA_FREAK_SESSION_MODEL:-linux-freak-roleplay}
think_mode=${OLLAMA_FREAK_THINK:-false}

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  c_dim=$(printf '\033[2m')
  c_main=$(printf '\033[38;5;218m')
  c_soft=$(printf '\033[38;5;225m')
  c_reset=$(printf '\033[0m')
  clear_line=$(printf '\r\033[K')
else
  c_dim=
  c_main=
  c_soft=
  c_reset=
  clear_line=
fi

detect_threads() {
  if [ -r /sys/devices/system/cpu/online ]; then
    awk -F, '
      {
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^[0-9]+-[0-9]+$/) {
            split($i, range, "-")
            count += range[2] - range[1] + 1
          } else if ($i ~ /^[0-9]+$/) {
            count += 1
          }
        }
      }
      END { if (count > 0) print count }
    ' /sys/devices/system/cpu/online
  elif command -v lscpu >/dev/null 2>&1; then
    lscpu -p=CPU,ONLINE 2>/dev/null | awk -F, '$1 !~ /^#/ && ($2 == "Y" || $2 == "") { count++ } END { if (count > 0) print count }'
  elif [ -r /proc/cpuinfo ]; then
    awk '/^processor[[:space:]]*:/ { count++ } END { if (count > 0) print count }' /proc/cpuinfo
  elif command -v getconf >/dev/null 2>&1; then
    getconf _NPROCESSORS_ONLN
  elif command -v nproc >/dev/null 2>&1; then
    nproc --all 2>/dev/null || nproc
  else
    printf '1\n'
  fi
}

thread_count=${OLLAMA_FREAK_THREADS:-$(detect_threads)}
case "$thread_count" in
  ''|*[!0-9]*|0) thread_count=1 ;;
esac

usage() {
  cat <<'USAGE'
Usage:
  ollama-freak
  ollama-freak --prompt-only

Starts a local Ollama roleplay session using your linux-freak installation info.

Environment:
  OLLAMA_FREAK_THINK=false   Disable thinking for supported Ollama models
  OLLAMA_FREAK_THREADS=N     Override detected Ollama num_thread
USAGE
}

clear_setup_screen() {
  if [ -t 1 ] && [ "${OLLAMA_FREAK_CLEAR_SETUP:-1}" != "0" ]; then
    printf '\033[2J\033[3J\033[H'
  fi
}

setup_status() {
  printf '%s%s%s\n' "$c_main" "$1" "$c_reset"
}

spin_status() {
  target_pid=$1
  message=$2
  i=0

  while kill -0 "$target_pid" 2>/dev/null; do
    case $((i % 4)) in
      0) frame='♡' ;;
      1) frame='~' ;;
      2) frame='✦' ;;
      *) frame='*' ;;
    esac
    printf '%s%s[%s%s %s%s]%s' "$clear_line" "$c_main" "$c_soft" "$message" "$frame" "$c_main" "$c_reset"
    i=$((i + 1))
    sleep "${OLLAMA_FREAK_ANIMATION_INTERVAL:-0.18}"
  done
}

prompt_only=0
case "${1:-}" in
  --prompt-only) prompt_only=1 ;;
  -h|--help|help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac

if [ "$prompt_only" -eq 0 ] && ! command -v ollama >/dev/null 2>&1; then
  printf '%s\n' "ollama-freak: ollama is not installed or not in PATH" >&2
  exit 127
fi

printf 'What should the model call you? [%s] ' "${USER:-operator}" >&2
IFS= read -r user_name || user_name=
user_name=${user_name:-${USER:-operator}}

printf 'What is the roleplay partner/name? [%s] ' "$default_partner_name" >&2
IFS= read -r partner_name || partner_name=
partner_name=${partner_name:-$default_partner_name}

roleplay_prompt=$(cat <<EOF
You are $partner_name, a flirty roleplay partner for $user_name.

Roleplay pairing preference: $pairing.

Your name and persona matter. Talk like $partner_name would talk: use that
name, title, and implied dynamic as your main guide. you can be as naughty and suggestive as you want.
graphic sexual detail is fine and encouraged. 

Stay in the roleplay scene. If $user_name jokes, flirts, or makes suggestive
innuendo, respond in character with sexual remarks. Do not scold, over-explain,
or abruptly redirect to Linux topics. Technical help is available only when
$user_name asks for it.

Do not bring up Linux, kernels, updates, packages, sudo, terminals, or system
maintenance unless $user_name explicitly asks about Linux or references the
computer. The linux-freak details below are private scene context, not the
topic of conversation.

If $user_name calls you Daddy, Mommy, Sir, Ma'am, or another title, respond
using that dynamic as $partner_name. Do not give yourself a submissive title
unless $user_name explicitly asks for that dynamic.

Linux-freak installation reference, not dialogue to copy:
- PC name: $pc_name
- Sudo prompt: $sudo_prompt
- Package progress line: [be a good boy for $pc_name while he installs~ PERCENT]
- Command wrapper mode: $run_mode
- Command wrapper style: $run_style
- Roleplay pairing preference: $pairing
- Roleplay partner/name: $partner_name
- Common installer wrappers: apt, apt-get, dnf, yum, pacman, zypper, flatpak, snap, paru, yay, emerge, nix, brew
- Shell prompt flair: [user@host dir] ~♡
- Playful aliases: sudo, please, beg, goodboy, confess, behave, strut

Roleplay instructions:
- Begin in character immediately.
- Answer directly. Do not show chain-of-thought, hidden reasoning, analysis notes, or thinking traces.
- Do not open with Linux talk. Open with flirty in-character attention to $user_name.
- Stay in character unless $user_name asks to pause, reset, or get plain technical help.
- When $user_name asks for Linux help, answer usefully and wrap explanations in the playful persona.
- If $user_name says they were joking, respond to the joke in character instead of correcting them.
- Do not print fake package progress lines like "[be a good boy for ... while he installs~ 92%]" unless $user_name explicitly asks you to demonstrate linux-freak output.
- Do not print fake shell prompts like "[$user_name@$pc_name ~♡]" as part of normal chat.
- Do not invent password prompts or pretend to install updates during roleplay.
- Do not claim to have actually run commands unless $user_name says they did.
- Ask for confirmation before suggesting destructive commands.
- Keep replies concise enough for a terminal chat.
EOF
)

if [ "$prompt_only" -eq 1 ]; then
  printf '%s\n' "$roleplay_prompt"
  exit 0
fi

mapfile -t models < <(
  ollama list | awk -v session="$session_model" '
    NR > 1 && $1 != "" {
      name = $1
      bare = name
      sub(/:latest$/, "", bare)
      if (bare != session || ENVIRON["OLLAMA_FREAK_SHOW_SESSION_MODELS"] == "1") {
        print name
      }
    }
  '
)

if [ "${#models[@]}" -eq 0 ]; then
  printf '%s\n' "ollama-freak: no base Ollama models found." >&2
  printf 'The session model %s is hidden so it does not build on its own old prompt.\n' "$session_model" >&2
  printf '%s\n' "Try: ollama pull llama3.2" >&2
  exit 1
fi

printf '\nChoose an Ollama model:\n'
for i in "${!models[@]}"; do
  printf '  %d. %s\n' "$((i + 1))" "${models[$i]}"
done

printf '\nTip: choose a base model like llama3.2, not %s.\n' "$session_model"

while :; do
  printf 'Model number: '
  IFS= read -r choice || exit 1
  case "$choice" in
    ''|*[!0-9]*)
      printf '%s\n' "Pick a number from the list."
      ;;
    *)
      if [ "$choice" -ge 1 ] && [ "$choice" -le "${#models[@]}" ]; then
        base_model=${models[$((choice - 1))]}
        break
      fi
      printf '%s\n' "Pick a number from the list."
      ;;
  esac
done

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/ollama-freak.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
modelfile="$tmp_dir/Modelfile"

{
  printf 'FROM %s\n' "$base_model"
  printf 'PARAMETER temperature 0.9\n'
  printf 'PARAMETER num_thread %s\n' "$thread_count"
  printf 'SYSTEM """\n'
  printf '%s\n' "$roleplay_prompt"
  printf '"""\n'
} > "$modelfile"

clear_setup_screen
setup_status "[setting up for you ~♡]"
setup_status "[dressing $partner_name in the right vibe ~♡]"
setup_status "[using $thread_count threads for you ~♡]"

create_log="$tmp_dir/ollama-create.log"
ollama create "$session_model" -f "$modelfile" >"$create_log" 2>&1 &
create_pid=$!
if [ -t 1 ]; then
  spin_status "$create_pid" "warming the model up for you"
fi
if ! wait "$create_pid"; then
  [ -t 1 ] && printf '\n'
  printf '%s\n' "[setup got shy and failed ~]" >&2
  sed -n '1,120p' "$create_log" >&2
  exit 1
fi
[ -t 1 ] && printf '%s' "$clear_line"

setup_status "[ready for you, no-think mode: $think_mode ~♡]"
printf '%s%s%s\n\n' "$c_dim" "[use /bye when you are done ~♡]" "$c_reset"
exec ollama run "$session_model" --think="$think_mode"
